+@contextmanager
+def query_lease(backend,tid):
+    # A queued workflow may safely retrieve an existing paid result, but its
+    # worker must not start the same task until the download has finished.
+    with backend.TASK_OPERATION_LOCK:
+        job=task_queue.get_queue(backend).get(tid)
+        if tid in backend.TASK_OPERATIONS or job and job['status'] in ('running','pausing','cancelling'):
+            raise ValueError('本任务正在处理，请等当前阶段完成后再查图')
+        backend.TASK_OPERATIONS.add(tid)
+    try:yield
+    finally:
+        with backend.TASK_OPERATION_LOCK:backend.TASK_OPERATIONS.discard(tid)
+        task_queue.get_queue(backend).wake.set()
+
+def query_existing(backend,tid,index,folder):
+    with query_lease(backend,tid):
+        import scene_images,image_auto_retry
+        _,target,_=scene_images.context(backend,tid,index,True)
+        if target.is_file() and target.stat().st_size:
+            return {'ok':True,'index':index,'cached':True}
+        receipt=folder/'image-jobs'/f'{index}.json';job=image_auto_retry.read_record(receipt)
+        if job.get('status') in ('failed','rejected') and not job.get('result'):
+            return {'ok':False,'index':index,'needs_retry':True}
+        if not job.get('result'):
+            if not job.get('taskId'):raise ValueError('没有可查询的原任务编号，请核对供应商记录；不会重复购买')
+            try:job=image_auto_retry.query_original(backend,None,receipt,job)
+            except RuntimeError as error:
+                if '仍在途或状态不明' in str(error):return {'ok':False,'index':index,'pending':True}
+                raise
+            if job.get('status')=='failed':return {'ok':False,'index':index,'needs_retry':True}
+        raw=task_cover.image_bytes(job['result'])
+        target.parent.mkdir(exist_ok=True);temporary=target.with_name(target.name+'.'+uuid.uuid4().hex+'.tmp')
+        try:
+            temporary.write_bytes(raw)
+            try:os.link(temporary,target)
+            except FileExistsError:
+                if target.stat().st_size==0:os.replace(temporary,target)
+        finally:temporary.unlink(missing_ok=True)
+        backend.complete_image_receipt(folder,index)
+        return {'ok':True,'index':index,'recovered':True}
+
