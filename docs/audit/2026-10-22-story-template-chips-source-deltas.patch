+function selectPromptTemplate(item,applyStyle=false){
+  const custom=item&&!item.builtin,group=$('tracks');
+  formLibraries.promptSnapshot=custom?item:null;
+  $('prompt-template').value=custom?item.id:'';
+  for(const chip of group.querySelectorAll('.chip'))chip.classList.toggle('active',custom?
+    chip.dataset.promptTemplate===item.id:!chip.dataset.promptTemplate&&chip.dataset.track===(item?.baseTrack||item?.id||'character-story'));
+  const style=item?.styleId||item?.defaultStyleId;
+  if(applyStyle&&style)document.querySelector(`.style-chip[data-preview="${style}"]`)?.click();
+}
+function renderPromptTemplateChips(){
+  const group=$('tracks');
+  group.querySelectorAll('[data-prompt-template]').forEach(chip=>chip.remove());
+  const selected=formLibraries.promptSnapshot;
+  const custom=formLibraries.prompts.filter(t=>!t.builtin);
+  if(selected&&!custom.some(t=>t.id===selected.id))custom.push(selected);
+  for(const item of custom){
+    const chip=document.createElement('button');chip.type='button';chip.className='chip';
+    chip.dataset.track=item.baseTrack||'character-story';chip.dataset.promptTemplate=item.id;
+    chip.textContent='🔧 '+item.name;chip.title=item.description||'';
+    chip.onclick=()=>selectPromptTemplate(item,true);group.append(chip);
+    chip.classList.toggle('active',selected?.id===item.id);
+  }
+}
+let promptRefreshPending;
+function refreshPromptTemplateChips(){
+  if(promptRefreshPending)return promptRefreshPending;
+  promptRefreshPending=(async()=>{
+    const value=await api('/api/templates/prompts');formLibraries.prompts=value.templates;
+    const pick=$('prompt-template');
+    for(const item of value.templates)if(![...pick.options].some(o=>o.value===item.id)){
+      const option=document.createElement('option');option.value=item.id;option.textContent=item.name;pick.append(option);
+    }
+    renderPromptTemplateChips();
+  })().finally(()=>{promptRefreshPending=null;});
+  return promptRefreshPending;
+}
